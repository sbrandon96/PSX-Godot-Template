[ext_resource type="Script" uid="uid://fnrn61tu7upx" path="res://psx/look/psx_look_preset.gd" id="1_preset"]

[resource]
script = ExtResource("1_preset")
jitter_enabled = true
snap_resolution = Vector2(160, 120)
