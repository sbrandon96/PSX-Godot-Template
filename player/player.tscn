[ext_resource type="Script" uid="uid://cx7a6cdcuky41" path="res://player/player.gd" id="1_player"]

; resource_local_to_scene is load-bearing: without it every instanced player
; would share one CapsuleShape3D and they would fight over its height while
; crouching. Height/radius here are overwritten from the script's exports on
; _ready(); these values only shape the editor gizmo.
