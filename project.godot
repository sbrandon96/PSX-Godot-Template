[physics]

3d/physics_engine="Jolt Physics"

[rendering]

textures/canvas_textures/default_texture_filter=0
rendering_device/driver.windows="d3d12"
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=true
textures/default_filters/anisotropic_filtering_level=0
scaling_3d/mode=5
scaling_3d/mode.ios=5
scaling_3d/mode.macos=5

[shader_globals]

psx_snap_resolution={
"type": "vec2",
"value": Vector2(320, 240)
}
psx_affine_strength={
"type": "float",
"value": 1.0
}
psx_color_depth={
"type": "float",
"value": 32.0
}
psx_dither_strength={
"type": "float",
"value": 1.0
}
psx_fog_enabled={
"type": "bool",
"value": true
}
psx_fog_color={
"type": "vec3",
"value": Vector3(0.05, 0.05, 0.08)
}
psx_fog_near={
"type": "float",
"value": 6.0
}
psx_fog_far={
"type": "float",
"value": 24.0
}
psx_jitter_enabled={
"type": "bool",
"value": true
}
