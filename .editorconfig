# Normalise line endings — LF in the repository
* text=auto eol=lf

*.gd      text eol=lf
*.tscn    text eol=lf
*.tres    text eol=lf
*.gdshader text eol=lf
*.cfg     text eol=lf
*.import  text eol=lf
*.md      text eol=lf

# Binary assets — never diff or normalise
*.png  binary
*.jpg  binary
*.webp binary
*.ogg  binary
*.wav  binary
*.glb  binary
*.gltf binary
*.ttf  binary
*.otf  binary