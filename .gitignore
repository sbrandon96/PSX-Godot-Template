# ---- Godot 4 ----------------------------------------------------------------
# Engine-generated cache. Never commit. Regenerates on import.
.godot/

# Android build template output
/android/

# Auto-generated translation binaries
*.translation

# ---- Exports ----------------------------------------------------------------
/builds/
/export/

# export_presets.cfg IS COMMITTED. A template whose export settings do not
# travel with it is not a template -- every derived project would have to
# rediscover the Compatibility/WebGL constraints by hand.
#
# It is committed because the Web preset carries no credentials. Android and
# iOS presets DO store keystore paths and passwords. If you add one, either
# keep the secrets in a Godot editor setting rather than the preset, or
# re-ignore this file.

# ---- OS / editor noise ------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
*.swp
*~
.vscode/
.idea/
